# OpenDayCare - plantilla de variables de entorno
#
# Copia este archivo a .env.local para desarrollo. Los archivos .env* están
# ignorados por Git; nunca guardes aquí secretos reales.

# ============================================================
# Aplicación
# ============================================================

# Origen público que se usa para construir enlaces de invitación.
APP_URL=http://localhost:3000
# Locale usado para formatos y mensajes regionales.
APP_LOCALE=es-EC
# Zona horaria IANA usada al normalizar fechas de negocio.
APP_TIME_ZONE=America/Guayaquil

# ============================================================
# Cloudinary (server-only)
# ============================================================

# URL con las credenciales del proveedor de almacenamiento de imágenes.
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@cloudinary_user

# ============================================================
# Mailer (server-only)
# ============================================================

# Cuenta SMTP usada para autenticarse y dirección que aparece como remitente.
MAILER_EMAIL=example@gmail.com
MAILER_SECRET_KEY=app_password_here
MAILER_FROM=example@gmail.com
# Servidor y puerto SMTP del proveedor de correo.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Indica si la conexión SMTP usa TLS implícito.
MAIL_SECURE=false
# Extensión de las plantillas HTML dentro de templates/.
MAIL_TEMPLATE_EXTENSION=html
# MAIL_TEMPLATE_PATH no se configura: se deriva automáticamente de templates/.

# ============================================================
# Autenticación y sesiones (server-only)
# ============================================================

# Secreto para firmar y cifrar la sesión JWT. Debe ser aleatorio y privado.
AUTH_SECRET=replace_with_a_random_secret
# Duración máxima de la sesión en segundos (604800 = 7 días).
AUTH_SESSION_MAX_AGE_SECONDS=604800
# Nombre de la cookie que contiene la sesión.
AUTH_SESSION_COOKIE_NAME=next-auth.session-token
# Impide que JavaScript del navegador lea la cookie.
AUTH_SESSION_COOKIE_HTTP_ONLY=true
# Envía la cookie solo por HTTPS; usar true en producción.
AUTH_SESSION_COOKIE_SECURE=false
# Política SameSite de la cookie: lax, strict o none.
AUTH_SESSION_COOKIE_SAME_SITE=lax
# Ruta del sitio en la que la cookie es válida.
AUTH_SESSION_COOKIE_PATH=/
# Ruta a la que se redirige a una persona no autenticada.
AUTH_SIGN_IN_PATH=/auth/login
# URL canónica usada por NextAuth para callbacks y enlaces.
NEXTAUTH_URL=http://localhost:3000

# ============================================================
# PostgreSQL mediante Supabase Session Pooler (server-only)
# ============================================================

# Host IPv4 del Session Pooler del proyecto Supabase.
SUPABASE_DB_HOST=aws-0-us-east-1.pooler.supabase.com
# Puerto PostgreSQL del pooler.
SUPABASE_DB_PORT=5432
# Usuario PostgreSQL del proyecto, normalmente postgres.<PROJECT_REF>.
SUPABASE_DB_USERNAME=postgres.your_project_ref
# Contraseña PostgreSQL; nunca debe exponerse al navegador.
SUPABASE_DB_PASSWORD=xxxxxxxxx

# Ejecuta pruebas que apuntan a una base remota cuando el flujo de pruebas lo requiere.
RUN_REMOTE_DB_TESTS=false

# ============================================================
# Herramientas opcionales, no necesarias para arrancar la aplicación
# ============================================================

# Contraseña y URL de conexión del rol de auditoría de base de datos.
# Solo las usa el procedimiento externo de db-security-auditor.
SECURITY_AUDITOR_DB_PASSWORD=xxxxxx
SECURITY_AUDITOR_DB_URL=postgresql://security_auditor.<PROJECT_REF>@<POOLER_HOST>:5432/postgres?sslmode=require

# Clave del MCP Context7 usada por OpenCode, no por Next.js.
CONTEXT7_API_KEY=xxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# Variables locales heredadas o reservadas
# ============================================================

# Estas variables aparecen en algunos entornos locales, pero no son leídas por
# el runtime actual de src/. Elimínalas si ninguna prueba o herramienta externa
# las necesita; no las configures en producción por defecto.
HTTP_MAX_IMAGE_BYTES=41943040
HTTP_MAX_IMAGES_PER_OPERATION=4
HTTP_MAX_ALT_LENGTH=200
HTTP_SERVER_ACTION_BODY_SIZE_BYTES=47185920
LOGIN_RATE_LIMIT_HMAC_SECRET=replace_with_local_test_secret
SUPABASE_DB_SSL_MODE=require

# Credenciales y tenant para pruebas E2E externas. No son necesarias para la app
# y nunca deben contener cuentas de producción.
E2E_DAYCARE_ID=<local-daycare-id>
E2E_STAFF_EMAIL=<local-staff-email>
E2E_STAFF_PASSWORD=<local-staff-password>

# NODE_ENV lo establece Next.js automáticamente; no lo dupliques aquí.
