# OpenDayCare - plantilla de producción
#
# Configura estos valores en el gestor de secretos del proveedor de hosting.
# No copies este archivo como .env con secretos reales ni lo versiones con
# valores reales. Todas estas variables son server-only.

# ============================================================
# Aplicación
# ============================================================

# Origen HTTPS público usado para enlaces de invitación.
APP_URL=https://app.example.com
# Locale para formatos regionales.
APP_LOCALE=es-EC
# Zona horaria IANA para fechas de negocio.
APP_TIME_ZONE=America/Guayaquil

# ============================================================
# Cloudinary
# ============================================================

# URL privada de Cloudinary para almacenamiento de imágenes.
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@cloudinary_user

# ============================================================
# Mailer SMTP
# ============================================================

# Cuenta y remitente del correo transaccional.
MAILER_EMAIL=<smtp-account>
MAILER_SECRET_KEY=<smtp-secret>
MAILER_FROM=<sender@example.com>
# Servidor, puerto y modo TLS del proveedor SMTP.
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_SECURE=true
# Extensión de las plantillas en templates/.
MAIL_TEMPLATE_EXTENSION=html

# ============================================================
# NextAuth y sesiones
# ============================================================

# Secreto aleatorio generado fuera del repositorio.
AUTH_SECRET=<random-production-secret>
# Duración máxima de la sesión JWT: 7 días.
AUTH_SESSION_MAX_AGE_SECONDS=604800
AUTH_SESSION_COOKIE_NAME=next-auth.session-token
AUTH_SESSION_COOKIE_HTTP_ONLY=true
# Debe ser true porque producción usa HTTPS.
AUTH_SESSION_COOKIE_SECURE=true
AUTH_SESSION_COOKIE_SAME_SITE=lax
AUTH_SESSION_COOKIE_PATH=/
AUTH_SIGN_IN_PATH=/auth/login
# URL HTTPS canónica de la aplicación.
NEXTAUTH_URL=https://app.example.com

# ============================================================
# PostgreSQL mediante Supabase Session Pooler
# ============================================================

SUPABASE_DB_HOST=<session-pooler-host>
SUPABASE_DB_PORT=5432
SUPABASE_DB_USERNAME=postgres.<PROJECT_REF>
SUPABASE_DB_PASSWORD=<database-password>

# Las pruebas remotas deben permanecer deshabilitadas en producción.
RUN_REMOTE_DB_TESTS=false

# NODE_ENV lo establece el proveedor/Next.js automáticamente.

# SECURITY_AUDITOR_DB_URL y SECURITY_AUDITOR_DB_PASSWORD no pertenecen al
# runtime de OpenDayCare. Se configuran solo en el entorno separado del auditor.
