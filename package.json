{
  "name": "open-daycare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint",
    "db:migrate:dry-run": "npx --yes supabase@3.0.0 db push --remote --dry-run --skip-vault",
    "db:migrate": "npx --yes supabase@3.0.0 db push --remote --yes --skip-vault",
    "db:seed": "npx --yes supabase@3.0.0 db query --file supabase/seed.sql"
  },
  "dependencies": {
    "@jmlq/mailer": "^0.0.1-beta.2",
    "bcryptjs": "3.0.3",
    "cloudinary": "^2.11.0",
    "env-var": "^7.5.0",
    "next": "^16.4.3",
    "next-auth": "4.24.15",
    "nodemailer": "^10.3.1",
    "postgres": "4.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
